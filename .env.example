# --- Database (MySQL) ---
# Local MySQL: localhost / 3306.
# Railway: use the PUBLIC TCP proxy domain + port (RAILWAY_TCP_PROXY_DOMAIN / RAILWAY_TCP_PROXY_PORT),
# NOT mysql.railway.internal (that only resolves inside Railway).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# sql/schema.sql creates this database. On Railway do NOT use the default "railway" database.
DB_NAME=campusfind_ai

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string

# --- Server ---
PORT=5000

# --- AI services ---
# Text similarity service (python-service/) runs on 8000, image similarity service (ml-service/) on 8001.
TEXT_SIMILARITY_URL=http://localhost:8000/similarity
ML_SIMILARITY_URL=http://localhost:8001
# How long to wait for the image service before ignoring photos for that comparison (ms).
ML_TIMEOUT_MS=8000
# Weight of the photo score in the final score when both items have a photo (0 to 1).
# final = (1 - IMAGE_WEIGHT) * text + IMAGE_WEIGHT * image. Without photos, final = text.
IMAGE_WEIGHT=0.4

# --- Automatic matching ---
# A lost/found pair scoring at or above this (0 to 1) gets a Pending match created automatically.
AUTO_MATCH_THRESHOLD=0.7
