# CampusFind AI — Frontend Environment Variables
# API endpoint base (leave blank to proxy through Vite dev server)
VITE_API_URL=

# Safe demo fallback flag (strictly false by default)
# false: Communicates exclusively with live backend; propagates all errors directly.
# true:  Permits fallback to offline sample data ONLY when backend server is genuinely unreachable.
VITE_DEMO_FALLBACK=false
