      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"1234567890\",\n  \"department\": \"CSE\",\n  \"year\": \"3\",\n  \"hostel\": \"A1\",\n  \"password\": \"Password123\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/students/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "register"]
            },
            "description": "Register a new student"
          },
          "event": [{
            "listen": "test",
            "script": {"exec": ["pm.test('Status code is 201', function () {", "    pm.response.to.have.status(201);", "});"]}
          }]
        },
        {
          "name": "Login Student",
          "request": {
            "method": "POST",
            "header": [],
